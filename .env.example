DJANGO_SECRET_KEY=replace-with-a-long-random-private-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
GEMINI_API_KEY=
NEXORA_AI_ENABLED=true
NEXORA_AI_MODEL=gemini-2.5-flash
NEXORA_AI_TIMEOUT_MS=20000
NEXORA_CONTEXT_CHARS=24000
NEXORA_PUBLIC_IP_PER_MINUTE=60
NEXORA_PUBLIC_BUSINESS_PER_DAY=1000
NEXORA_PUBLIC_GLOBAL_PER_DAY=5000
# Shared Gemini request budgets: public chat and Playground combined.
# A failed provider attempt also consumes one unit. Zero disables paid calls.
NEXORA_AI_BUSINESS_PER_DAY=1000
NEXORA_AI_GLOBAL_PER_DAY=5000
# Set true only behind tested HTTPS deployment; never use runserver for production.
NEXORA_PRODUCTION=false

# Production-only options (configure with your actual HTTPS domain):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_HSTS_SECONDS=3600
# Enable only if your trusted reverse proxy sanitizes X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_SSL_HEADER=false

# Render production: use Render environment variables (not a committed .env).
# DATABASE_URL=postgresql://...
# DJANGO_ALLOWED_HOSTS=your-service.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# DJANGO_DEBUG=False
# NEXORA_PRODUCTION=true
# DJANGO_TRUST_PROXY_SSL_HEADER=true
